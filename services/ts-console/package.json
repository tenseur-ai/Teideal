{
  "name": "@teideal/ts-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Console/admin/customer-facing API surface for Teideal (customers CRUD, security dashboard, support portal). Owns customers and security_events reads.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate:export-doc": "tsx src/scripts/generateExportFormatDoc.ts",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1141.0",
    "@aws-sdk/client-sts": "3.1141.0",
    "@dsnp/parquetjs": "1.8.8",
    "bcryptjs": "^3.0.3",
    "exceljs": "4.4.0",
    "fastify": "^5.1.0",
    "jose": "^6.2.12",
    "otpauth": "^9.5.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
